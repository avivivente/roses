set {areas.has_interacted_with_gate} = true
if {areas.has_key1} == true:
	if {areas.has_interacted_area2_gate} == true:
		join key (Key) center [animation="Fade In Up"]
		Leticia: I hope the key is for this one, I don't want to go back in that cave if it wasn't.
		leave key [animation="Instant Out"]
		[signal arg="take_key"]
		[signal arg="open_gate"]
		if {tasks.has_rose1} == true:
			Leticia: That worked, I'll get the rose to the Old Lady now.
		else:
			Leticia: That worked, but I still haven't found what the Old Lady was looking for...
	elif {areas.has_interacted_with_gate} == true:
		join key (Key) center [animation="Fade In Up"]
		Leticia: I hope this key works.
		leave key [animation="Instant Out"]
		[signal arg="take_key"]
		[signal arg="open_gate"]
		if {tasks.has_rose1} == true:
			Leticia: That worked, I'll get the rose to the Old Lady now.
		else:
			Leticia: That worked, but I still haven't found what the Old Lady was looking for...
	set {areas.has_key1} = false
else:
	Leticia: It's locked. What are the chances that there will be a key here somewhere...?